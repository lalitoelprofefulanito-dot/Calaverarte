{
  "name": "calaverarte",
  "version": "1.0.0",
  "description": "Generador, editor, evaluador y taller de calaveritas literarias mexicanas (motor local basado en reglas).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build && node scripts/inline-single-file.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "vite": "^6.4.4",
    "vitest": "4.1.11"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
